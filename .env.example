# AI Provider Configuration
# Leave empty for mock mode (works offline, no API key needed)
# Primary: set GROQ_API_KEY to use Groq (Llama 3.3 70B). Fallback: set
# AI_PROVIDER=gemini + GEMINI_API_KEY. AI_MODEL overrides the default model.
AI_PROVIDER=
GEMINI_API_KEY=
GROQ_API_KEY=
AI_MODEL=

# Storage provider: 'sqlite' (local dev, default) or 'firestore' (Vercel/Firebase)
DB_PROVIDER=

# Firebase Admin SDK (server-side only — read via process.env at runtime,
# never import.meta.env, which Vite inlines into the bundle at build time)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Use \n escapes for newlines if pasted as a single line
FIREBASE_PRIVATE_KEY=
# Web API key (public; used only for the Identity Toolkit REST calls from the server)
FIREBASE_WEB_API_KEY=

# Firebase emulator hosts (local testing only, e.g. demo-studylog project)
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
